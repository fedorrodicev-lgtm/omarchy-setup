#!/usr/bin/env python3
# Prints one JSON blob for the F1 bar widget: the upcoming race weekend,
# the drivers' championship and the last race's result, from the Jolpica
# (Ergast-compatible) API. Responses are cached so the bar keeps showing
# data offline and the API is hit at most once per CACHE_SECONDS.

import json
import os
import sys
import time
import urllib.request
from datetime import datetime, timedelta, timezone

API = "https://api.jolpi.ca/ergast/f1"
CACHE = os.path.expanduser("~/.cache/omarchy/f1.json")
CACHE_SECONDS = 30 * 60

SESSIONS = [
    ("FirstPractice", "FP1"),
    ("SecondPractice", "FP2"),
    ("ThirdPractice", "FP3"),
    ("SprintQualifying", "Sprint Quali"),
    ("SprintShootout", "Sprint Quali"),
    ("Sprint", "Sprint"),
    ("Qualifying", "Quali"),
]


def get(path):
    req = urllib.request.Request(API + path, headers={"User-Agent": "omarchy-f1-widget/1.0"})
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.load(resp)["MRData"]


def utc(day, clock):
    return f"{day}T{clock or '00:00:00Z'}"


def race_start(race):
    return datetime.fromisoformat(utc(race["date"], race.get("time")).replace("Z", "+00:00"))


def upcoming_race(now):
    # A race stays "upcoming" until three hours after lights out, so the
    # widget can show it live instead of skipping ahead mid-race.
    for season in ("current", str(now.year + 1)):
        races = get(f"/{season}.json?limit=40")["RaceTable"]["Races"]
        for race in races:
            if race_start(race) + timedelta(hours=3) > now:
                return race
    return None


def weekend(race):
    sessions = [
        {"name": label, "start": utc(race[key]["date"], race[key].get("time"))}
        for key, label in SESSIONS
        if key in race
    ]
    sessions.append({"name": "Race", "start": utc(race["date"], race.get("time"))})
    sessions.sort(key=lambda s: s["start"])
    loc = race["Circuit"]["Location"]
    return {
        "name": race["raceName"],
        "round": race["round"],
        "season": race["season"],
        "circuit": race["Circuit"]["circuitName"],
        "locality": loc["locality"],
        "country": loc["country"],
        "start": sessions[-1]["start"],
        "sessions": sessions,
    }


def standings():
    lists = get("/current/driverStandings.json")["StandingsTable"]["StandingsLists"]
    if not lists:
        return {"round": "", "drivers": []}
    table = lists[0]
    return {
        "round": table["round"],
        "drivers": [
            {
                "pos": s.get("position", s.get("positionText", "")),
                "code": s["Driver"].get("code", s["Driver"]["familyName"][:3].upper()),
                "id": s["Driver"]["driverId"],
                "name": s["Driver"]["familyName"],
                "team": s["Constructors"][0]["name"] if s["Constructors"] else "",
                "points": s["points"],
            }
            for s in table["DriverStandings"]
        ],
    }


def last_race():
    races = get("/current/last/results.json?limit=40")["RaceTable"]["Races"]
    if not races:
        return None
    race = races[0]
    return {
        "name": race["raceName"],
        "results": [
            {
                "pos": r["positionText"],
                "code": r["Driver"].get("code", r["Driver"]["familyName"][:3].upper()),
                "id": r["Driver"]["driverId"],
                "name": r["Driver"]["familyName"],
                "team": r["Constructor"]["name"],
                "gap": r.get("Time", {}).get("time") or r["status"],
                "points": r["points"],
            }
            for r in race["Results"]
        ],
    }


def fetch():
    now = datetime.now(timezone.utc)
    race = upcoming_race(now)
    return {
        "fetchedAt": int(time.time()),
        "next": weekend(race) if race else None,
        "standings": standings(),
        "last": last_race(),
    }


def read_cache():
    try:
        with open(CACHE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def main():
    force = "--refresh" in sys.argv
    cached = read_cache()
    fresh_enough = cached and time.time() - cached.get("fetchedAt", 0) < CACHE_SECONDS
    # Past the race the cached "next" weekend is stale even if the cache is young.
    if fresh_enough and cached.get("next"):
        start = datetime.fromisoformat(cached["next"]["start"].replace("Z", "+00:00"))
        fresh_enough = start + timedelta(hours=3) > datetime.now(timezone.utc)

    if fresh_enough and not force:
        print(json.dumps(cached))
        return

    try:
        data = fetch()
    except Exception as e:
        if cached:
            cached["stale"] = True
            print(json.dumps(cached))
            return
        print(json.dumps({"error": str(e)}))
        sys.exit(1)

    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    tmp = CACHE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, CACHE)
    print(json.dumps(data))


if __name__ == "__main__":
    main()
