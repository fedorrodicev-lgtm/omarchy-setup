#!/bin/bash

# macOS-style window screenshot: the window's rounded corners become
# transparent (cut just inside the Hyprland rounding, so no border fringe is
# left), with a thin hairline outline and a soft drop shadow on an even
# transparent margin.
#
#   screenshot-window-mac            smart picker, like Super+Shift+S: a click
#                                    on a window (or Tab / arrows) gives the
#                                    styled shot, a dragged region stays plain
#   screenshot-window-mac windows    windows-only picker, always styled
#   screenshot-window-mac active     capture the focused window
#
# Env: MAC_SHOT_SHADOW=0 disables the shadow, MAC_SHOT_OUTLINE=<color>
# and MAC_SHOT_OUTLINE_OPACITY=<0..1> change the hairline (default: white at
# 0.22, MAC_SHOT_OUTLINE=none to disable).

set -o pipefail

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${OMARCHY_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"
mkdir -p "$OUTPUT_DIR"

SHADOW="${MAC_SHOT_SHADOW:-1}"
OUTLINE="${MAC_SHOT_OUTLINE:-white}"
OUTLINE_OPACITY="${MAC_SHOT_OUTLINE_OPACITY:-0.22}"

pkill slurp && exit 0

TMP=$(mktemp -d)
FREEZE_PID=""
cleanup() {
  [[ -n $FREEZE_PID ]] && kill "$FREEZE_PID" 2>/dev/null
  rm -rf "$TMP"
}
trap cleanup EXIT

MODE="${1:-smart}"

# Same window rectangles the Omarchy picker offers on the active workspace.
window_rects() {
  local ws
  ws=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .activeWorkspace.id')
  hyprctl clients -j | jq -r --argjson ws "$ws" \
    '.[] | select(.workspace.id == $ws and .hidden != true) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
}

notify() {
  wl-copy --type image/png <"$1"
  omarchy-notification-send "Screenshot saved to clipboard and file" "$(basename "$1")" \
    --image "$1" --exec "${OMARCHY_SCREENSHOT_EDITOR:-tensaku-edit}" "$1" || true
}

# Software-composited cursors get baked into grim frames; force hardware
# cursors while capturing, as omarchy-capture-screenshot does.
NO_HW_CURSORS=$(hyprctl getoption cursor:no_hardware_cursors -j | jq '.int')
set_no_hw_cursors() {
  hyprctl eval "hl.config({ cursor = { no_hardware_cursors = $1 } })" &>/dev/null ||
    hyprctl keyword cursor:no_hardware_cursors "$1" &>/dev/null
}
set_no_hw_cursors 0
restore_cursor() { set_no_hw_cursors "$NO_HW_CURSORS"; }

case $MODE in
active)
  SELECTION=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
  ;;
windows | smart)
  { read -r FREEZE_PID; read -r SELECTION; } < <(omarchy-capture-region "$MODE" --keep-freeze)
  ;;
*)
  echo "usage: $(basename "$0") [smart|windows|active]" >&2
  exit 1
  ;;
esac
[[ $SELECTION =~ ^-?[0-9]+,-?[0-9]+\ [0-9]+x[0-9]+$ ]] || { restore_cursor; exit 0; }

grim -g "$SELECTION" "$TMP/shot.png" || { restore_cursor; exit 1; }
restore_cursor
[[ -n $FREEZE_PID ]] && kill "$FREEZE_PID" 2>/dev/null
FREEZE_PID=""

FILEPATH="$OUTPUT_DIR/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"

# In smart mode only a whole window gets the macOS treatment; a dragged region
# or a whole monitor is saved as is.
if [[ $MODE == smart ]] && ! window_rects | grep -qxF "$SELECTION"; then
  cp "$TMP/shot.png" "$FILEPATH"
  echo "$FILEPATH"
  notify "$FILEPATH"
  exit 0
fi

# Corner radius in physical pixels: Hyprland rounding x monitor scale.
SCALE=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .scale')
ROUNDING=$(hyprctl getoption decoration:rounding -j | jq '.int')
read -r W H < <(magick identify -format '%w %h' "$TMP/shot.png")

# Measured against real captures: with a border, the window content's corner
# is close to a circle (~3px past rounding x scale), whatever rounding_power
# says. Cutting a hair inside it leaves no border/wallpaper fringe.
R=$(awk -v r="$ROUNDING" -v s="$SCALE" 'BEGIN { printf "%d", r * s + 3.5 }')
POWER="${MAC_SHOT_CORNER_POWER:-2}"

if ((R > 1)); then
  # Top-left corner tile of the superellipse |x|^p + |y|^p <= 1, rendered at
  # 4x and downscaled for antialiasing.
  SS=$((R * 4))
  magick -size "${SS}x${SS}" xc:black -fx \
    "dx = max(1 - (i + 0.5) / w, 0); dy = max(1 - (j + 0.5) / h, 0); pow(dx, $POWER) + pow(dy, $POWER) <= 1 ? 1 : 0" \
    -resize "${R}x${R}" "$TMP/corner.png"

  magick -size "${W}x${H}" xc:white \
    "$TMP/corner.png" -geometry +0+0 -composite \
    \( "$TMP/corner.png" -flop \) -geometry "+$((W - R))+0" -composite \
    \( "$TMP/corner.png" -flip \) -geometry "+0+$((H - R))" -composite \
    \( "$TMP/corner.png" -flip -flop \) -geometry "+$((W - R))+$((H - R))" -composite \
    "$TMP/mask.png"
else
  magick -size "${W}x${H}" xc:white "$TMP/mask.png"
fi

magick "$TMP/shot.png" "$TMP/mask.png" -alpha off -compose CopyOpacity -composite "$TMP/window.png"

# Hairline: a ~1px ring along the inside of the mask, painted over the window.
if [[ $OUTLINE != none ]]; then
  magick "$TMP/mask.png" \( +clone -morphology Erode Disk:1 \) \
    -compose MinusSrc -composite -alpha off \
    -background "$OUTLINE" -alpha shape \
    -channel A -evaluate multiply "$OUTLINE_OPACITY" +channel "$TMP/outline.png"
  magick "$TMP/window.png" "$TMP/outline.png" -compose Over -composite "$TMP/window.png"
fi

if [[ $SHADOW != 0 ]]; then
  # Same margin on every side; the shadow drops slightly but stays inside it.
  PAD=$(awk -v s="$SCALE" 'BEGIN { printf "%d", 18 * s }')
  SIGMA=$(awk -v s="$SCALE" 'BEGIN { printf "%.1f", 6 * s }')
  DROP=$(awk -v s="$SCALE" 'BEGIN { printf "%d", 3 * s }')
  magick -size "$((W + 2 * PAD))x$((H + 2 * PAD))" xc:none \
    \( "$TMP/window.png" -alpha extract -background black -alpha shape \
       -channel A -evaluate multiply 0.45 +channel \
       -bordercolor none -border "$PAD" -blur "0x$SIGMA" \) \
    -geometry "+0+$DROP" -compose Over -composite \
    "$TMP/window.png" -geometry "+$PAD+$PAD" -compose Over -composite \
    -depth 8 "$FILEPATH" || exit 1
else
  cp "$TMP/window.png" "$FILEPATH"
fi

echo "$FILEPATH"
notify "$FILEPATH"
